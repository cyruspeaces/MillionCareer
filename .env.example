# PostgreSQL 连接串（本地示例）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/million_career?schema=public"

# 应用
NEXT_PUBLIC_APP_NAME="百万职场"

# 鉴权（生产务必更换）
JWT_SECRET="dev-change-me-million-career"

# 短信：true 时不调腾讯云，固定验证码（仅本地）
SMS_USE_MOCK="false"
SMS_MOCK_CODE="111111"

# 腾讯云短信（SMS_USE_MOCK=false 时必填）
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""
TENCENT_SMS_SDK_APP_ID=""
TENCENT_SMS_SIGN_NAME=""
TENCENT_SMS_TEMPLATE_ID=""
TENCENT_SMS_REGION="ap-guangzhou"
TENCENT_SMS_CODE_TTL_MINUTES="5"
